# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres connection string (pooled). https://console.neon.tech
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (+ your prod URL)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Needed only when running `next start` outside Vercel (Vercel trusts its host automatically).
# AUTH_TRUST_HOST=true

# LOCAL DEV ONLY: skip Google sign-in and act as this email (made app admin).
# Ignored unless running `pnpm dev`; production builds never honor it.
# DEV_AUTH_BYPASS_EMAIL="you@example.com"

# Email of the app admin. Seeded into the allowlist and granted admin on first sign-in.
ADMIN_EMAIL="you@example.com"

# LLM providers (free tiers). At least one key is required for text parsing.
GOOGLE_GENERATIVE_AI_API_KEY=""
GROQ_API_KEY=""
# Model IDs are configurable because free-tier model names change.
LLM_PRIMARY_MODEL="gemini-flash-latest"
LLM_FALLBACK_MODEL="llama-3.3-70b-versatile"
# Max LLM parse requests per user per hour (best-effort, per server instance).
PARSE_RATE_LIMIT_PER_HOUR="60"
